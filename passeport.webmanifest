/* ============================================================
   SALAD&CO — Charte commune
   Tokens de marque partagés par toutes les applications.
   Chargé par le hub et par chaque appli (chrome commun).
   ============================================================ */
:root{
  /* Marque */
  --sc-green:#6cbe2e;      /* vert Salad&Co (primaire) */
  --sc-green-d:#4f9a1c;    /* vert foncé (survol / actif) */
  --sc-green-l:#eaf7dd;    /* vert clair (fonds) */
  --sc-ink:#1b1d1a;        /* encre / fond sombre de marque */
  --sc-ink-2:#2a2d29;
  --sc-paper:#f6f7f4;      /* fond clair */
  --sc-card:#ffffff;
  --sc-text:#14160f;
  --sc-text-2:#5b5f55;
  --sc-border:rgba(20,22,15,.12);
  --sc-shadow:0 1px 2px rgba(20,22,15,.06), 0 10px 30px rgba(20,22,15,.08);
  --sc-radius:16px;
  --sc-font:system-ui,-apple-system,"Segoe UI",Roboto,Helvetica,Arial,sans-serif;
}
@media (prefers-color-scheme: dark){
  :root{
    --sc-paper:#0f100d; --sc-card:#1a1c16; --sc-text:#f3f5ee; --sc-text-2:#b4b8ab;
    --sc-border:rgba(255,255,255,.12);
    --sc-shadow:0 1px 2px rgba(0,0,0,.5), 0 12px 34px rgba(0,0,0,.45);
    --sc-green-l:#243016;
  }
}
